
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#050816">
<title>Kurkheda Game Zone</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  background: #050816;
  color: white;
  font-family: Arial, sans-serif;
}

.screen {
  min-height: 100vh;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 24px;
  overflow: hidden;
  position: relative;
  background: radial-gradient(circle, #192b63, #050816 70%);
}

.screen::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(#39e9ff18 1px, transparent 1px),
    linear-gradient(90deg, #39e9ff18 1px, transparent 1px);
  background-size: 35px 35px;
  animation: moveGrid 5s linear infinite;
}

.label {
  color: #54f4ff;
  letter-spacing: 5px;
  font-size: 12px;
  margin-bottom: 24px;
  z-index: 1;
}

h1 {
  font-size: clamp(36px, 10vw, 68px);
  line-height: 1.1;
  margin: 0;
  z-index: 1;
  text-shadow: 0 0 25px #00d9ff80;
}

h1 span { color: #54f4ff; }

#caption {
  min-height: 90px;
  max-width: 700px;
  font-size: clamp(20px, 5vw, 30px);
  font-weight: bold;
  line-height: 1.4;
  margin-top: 28px;
  opacity: 0;
  transform: translateY(15px);
  transition: .4s;
  z-index: 1;
}

#caption.show {
  opacity: 1;
  transform: translateY(0);
}

#date {
  display: none;
  margin-top: 12px;
  color: #ffe56c;
  font-size: 24px;
  font-weight: 900;
  z-index: 1;
}

#location {
  display: none;
  color: #54f4ff;
  font-size: 16px;
  line-height: 1.6;
  margin-top: 12px;
  z-index: 1;
}

button {
  display: none;
  margin-top: 20px;
  padding: 12px 20px;
  border-radius: 25px;
  border: 1px solid #54f4ff;
  color: white;
  background: #101a3e;
  cursor: pointer;
  z-index: 1;
}

#status {
  position: absolute;
  bottom: 18px;
  color: #99a9db;
  font-size: 10px;
  letter-spacing: 3px;
  z-index: 1;
}

@keyframes moveGrid {
  from { background-position: 0 0; }
  to { background-position: 0 35px; }
}
</style>
</head>

<body>
<main class="screen">
  <div class="label">GET READY • GAME ON</div>

  <h1>KURKHEDA<br><span>GAME ZONE</span></h1>

  <p id="caption" aria-live="polite"></p>
  <p id="date">OPENING • OCTOBER 11</p>

  <p id="location">
    Near Old Bank of India,<br>
    Near Sai Stationery
  </p>

  <button id="replay">PLAY INTRO AGAIN</button>
  <div id="status">POWER UP YOUR PLAY</div>
</main>

<script>
const scenes = [
  "KURKHEDA... ARE YOU READY?",
  "THE WAIT IS ALMOST OVER!",
  "STEP INTO THE WORLD OF GAMING!",
  "PLAYSTATION 4. PLAYSTATION 3.",
  "RACING. ACTION. EPIC BATTLES.",
  "BRING YOUR FRIENDS. CHALLENGE EACH OTHER!",
  "YOUR GAME. YOUR SKILLS. YOUR MOMENT!",
  "WE OPEN ON OCTOBER ELEVENTH!",
  "KURKHEDA GAME ZONE — PLAY HARD, HAVE FUN!"
];

const caption = document.getElementById("caption");
const date = document.getElementById("date");
const locationText = document.getElementById("location");
const replay = document.getElementById("replay");
const status = document.getElementById("status");

let currentRun = 0;

function playScene(index, run) {
  if (run !== currentRun) return;

  if (index >= scenes.length) {
    caption.classList.remove("show");
    date.style.display = "block";
    locationText.style.display = "block";
    replay.style.display = "inline-block";
    status.textContent = "PLAY HARD • HAVE FUN";
    return;
  }

  caption.classList.remove("show");

  setTimeout(() => {
    if (run !== currentRun) return;

    const text = scenes[index];
    caption.textContent = text;
    caption.classList.add("show");

    if ("speechSynthesis" in window) {
      const speech = new SpeechSynthesisUtterance(text);
      speech.lang = "en-IN";
      speech.rate = 0.9;
      speech.pitch = 0.9;

      speech.onend = () => {
        if (run !== currentRun) return;

        caption.classList.remove("show");
        setTimeout(() => playScene(index + 1, run), 350);
      };

      speech.onerror = () => {
        if (run === currentRun) {
          setTimeout(() => playScene(index + 1, run), 2500);
        }
      };

      speechSynthesis.speak(speech);
    } else {
      setTimeout(() => playScene(index + 1, run), 2800);
    }
  }, 350);
}

function startIntro() {
  currentRun++;

  if ("speechSynthesis" in window) {
    speechSynthesis.cancel();
  }

  caption.textContent = "";
  caption.classList.remove("show");
  date.style.display = "none";
  locationText.style.display = "none";
  replay.style.display = "none";
  status.textContent = "POWER UP YOUR PLAY";

  playScene(0, currentRun);
}

replay.addEventListener("click", startIntro);

window.addEventListener("load", startIntro);
</script>
</body>
</html>
